#!/usr/bin/with-contenv bash
# shellcheck shell=bash

NT_LOG=""

function __debug {

exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost 6379" \
    s6-setuidgid root $(which redis-server)

}

function __false {

exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost 6379" \
    s6-setuidgid root $(which redis-server) > /dev/null 2>&1

}

if [ -f ${NASTOOL_CONFIG} ]; then
    if command -v yq >/dev/null 2>&1; then
        NT_LOG=$(yq -r '.app.loglevel // empty' "${NASTOOL_CONFIG}" 2>/dev/null || true)
    else
        NT_LOG=$(grep -E '^[[:space:]]*loglevel:[[:space:]]*[A-Za-z]+' "${NASTOOL_CONFIG}" | head -n 1 | sed -E 's/.*loglevel:[[:space:]]*([A-Za-z]+).*/\1/' || true)
    fi
    if [[ "${NT_LOG}" == "debug" ]]; then
        __debug
    else
        __false
    fi
else
    __false
fi
